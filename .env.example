APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=hms
DB_PASSWORD=secret
# Used only by docker-compose to seed the MySQL root password; not read by the app itself.
DB_ROOT_PASSWORD=secret

# database (not redis) is deliberate: FR-AUTH-009 lists/revokes sessions per device,
# which needs the sessions table's ip_address/user_agent/last_activity columns.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hms_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Multi-branch/tenant defaults (overridable per branch once branches exist — see docs/SRS.md 2.4).
APP_TIMEZONE=UTC
DEFAULT_CURRENCY=USD

# Comma-separated list of email addresses permitted to view Telescope/Horizon dashboards in non-local environments.
TELESCOPE_ALLOWED_EMAILS=
HORIZON_ALLOWED_EMAILS=

# laravel/telescope is a require-dev package. Set this to false in production —
# it's not gated by APP_ENV, and the "allowed_emails" list above only controls
# who can view the dashboard, not whether it (and its watchers) run at all.
TELESCOPE_ENABLED=true

# Account lockout / password policy (FR-AUTH-006, FR-AUTH-007, FR-AUTH-008)
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_HISTORY_COUNT=5
AUTH_PASSWORD_EXPIRY_DAYS=90

# Payment gateways (leave blank until configured; never commit real secrets)
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
